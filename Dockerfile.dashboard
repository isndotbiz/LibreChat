FROM python:3.12-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi==0.115.* \
    uvicorn[standard]==0.34.* \
    httpx==0.28.* \
    psycopg2-binary==2.9.* \
    pydantic==2.*

# Copy application code from llm-security-research
# Build context should be the llm-security-research directory
COPY server_fastapi.py ./
COPY src/lib/ ./src/lib/
COPY webapp/ ./webapp/
COPY prompts/ ./prompts/
COPY external-resources/ ./external-resources/
COPY evaluations/ ./evaluations/
COPY config/ ./config/

# Create empty directories that the server expects
RUN mkdir -p data logs reports

EXPOSE 8091

CMD ["uvicorn", "server_fastapi:app", "--host", "0.0.0.0", "--port", "8091"]
